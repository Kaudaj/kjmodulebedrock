{% extends '@PrestaShop/Admin/layout.html.twig' %}
{% trans_default_domain 'Modules.Kjmodulebedrock.Admin' %}

{% block content %}
  {{ form_start(general_form, {action: path('kj_module_bedrock_settings_general_save'), method: 'POST'}) }}
    <div class="card" id="kj-module-bedrock-general-settings">
      <h3 class="card-header">
        <i class="material-icons">settings</i>
        {{ 'General settings'|trans }}
      </h3>
      <div class="card-body">
        <div class="form-wrapper">
          {{ form_widget(general_form) }}
        </div>
      </div>
      <div class="card-footer">
        <div class="d-flex justify-content-end">
          <button class="btn btn-primary" type="submit" id="kj-module-bedrock-general-settings-submit">
            {{ 'Save'|trans({}, 'Admin.Actions') }}
          </button>
        </div>
      </div>
    </div>
  {{ form_end(general_form) }}

  <div class="card mt-3" id="kj-module-bedrock-vue-demo-card">
    <h3 class="card-header">
      <i class="material-icons">widgets</i>
      {{ 'UI kit playground'|trans }}
    </h3>
    <div class="card-body">
      <div
        id="kj-module-bedrock-vue-app"
        data-example-setting="{{ general_form.vars.value.example_setting|default('') }}"
      >
        <div class="text-muted">{{ 'Loading the Vue 3 + PrestaShop UI Kit example...'|trans }}</div>
      </div>
    </div>
  </div>
{% endblock %}

{% block stylesheets %}
  {{ parent() }}

  <link rel="stylesheet" href="{{ asset('../modules/kjmodulebedrock/views/css/back.css') }}" type="text/css" media="all">
{% endblock %}

{% block javascripts %}
  {{ parent() }}

  <script type="module" src="{{ asset('../modules/kjmodulebedrock/views/js/back.js') }}"></script>
{% endblock %}
